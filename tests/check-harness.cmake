execute_process(COMMAND "${HARNESS}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Harness accounting failed: ${status}\n${output}\n${errors}")
endif()
string(REGEX MATCHALL "PASSED" passes "${output}")
string(REGEX MATCHALL "FAILED" failures "${output}")
list(LENGTH passes pass_count)
list(LENGTH failures fail_count)
if(NOT pass_count EQUAL 1 OR NOT fail_count EQUAL 1)
  message(FATAL_ERROR "Expected one pass and one failure, got:\n${output}")
endif()
